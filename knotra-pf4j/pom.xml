<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.knotra</groupId>
        <artifactId>knotra-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>knotra-pf4j</artifactId>
    <name>Knotra PF4J Adapter</name>

    <dependencies>
        <dependency>
            <groupId>io.knotra</groupId>
            <artifactId>knotra-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.knotra</groupId>
            <artifactId>knotra-pf4j-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-shared-test-contract</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/contract</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/test-classes</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-test-plugin</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/plugin</compileSourceRoot>
                                <compileSourceRoot>${project.basedir}/src/test/contract</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/plugin-classes</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-dependent-test-plugin</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/dependent-plugin</compileSourceRoot>
                                <compileSourceRoot>${project.basedir}/src/test/contract</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/dependent-plugin-classes</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-plugin-extension-index</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugin-classes</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/test/plugin</directory>
                                    <includes>
                                        <include>META-INF/extensions.idx</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-dependent-plugin-extension-index</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependent-plugin-classes</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/test/dependent-plugin</directory>
                                    <includes>
                                        <include>META-INF/extensions.idx</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-plugin-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/plugin-classes</classesDirectory>
                            <outputDirectory>${project.build.directory}/fixtures</outputDirectory>
                            <includes>
                                <include>com/example/knotra/plugin/**</include>
                                <include>META-INF/**</include>
                            </includes>
                            <archive>
                                <manifestEntries>
                                    <Plugin-Id>knotra-test-plugin</Plugin-Id>
                                    <Plugin-Version>1.0.0</Plugin-Version>
                                </manifestEntries>
                            </archive>
                            <classifier>fixture</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dependent-test-plugin-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/dependent-plugin-classes</classesDirectory>
                            <outputDirectory>${project.build.directory}/fixtures</outputDirectory>
                            <includes>
                                <include>com/example/knotra/dependent/**</include>
                                <include>META-INF/**</include>
                            </includes>
                            <archive>
                                <manifestEntries>
                                    <Plugin-Id>knotra-dependent-plugin</Plugin-Id>
                                    <Plugin-Version>1.0.0</Plugin-Version>
                                    <Plugin-Dependencies>knotra-test-plugin</Plugin-Dependencies>
                                </manifestEntries>
                            </archive>
                            <classifier>dependent-fixture</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>start-failure-test-plugin-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/plugin-classes</classesDirectory>
                            <outputDirectory>${project.build.directory}/fixtures</outputDirectory>
                            <includes>
                                <include>com/example/knotra/plugin/**</include>
                                <include>META-INF/**</include>
                            </includes>
                            <archive>
                                <manifestEntries>
                                    <Plugin-Id>knotra-start-failure-plugin</Plugin-Id>
                                    <Plugin-Version>1.0.0</Plugin-Version>
                                    <Plugin-Dependencies>knotra-test-plugin</Plugin-Dependencies>
                                    <Plugin-Class>com.example.knotra.plugin.ThrowingStartPlugin</Plugin-Class>
                                </manifestEntries>
                            </archive>
                            <classifier>start-failure-fixture</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>optional-missing-test-plugin-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/plugin-classes</classesDirectory>
                            <outputDirectory>${project.build.directory}/fixtures</outputDirectory>
                            <includes>
                                <include>com/example/knotra/plugin/**</include>
                                <include>META-INF/**</include>
                            </includes>
                            <archive>
                                <manifestEntries>
                                    <Plugin-Id>knotra-optional-plugin</Plugin-Id>
                                    <Plugin-Version>1.0.0</Plugin-Version>
                                    <Plugin-Dependencies>absent-knotra-dependency?</Plugin-Dependencies>
                                </manifestEntries>
                            </archive>
                            <classifier>optional-fixture</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
