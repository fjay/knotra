<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.knotra</groupId>
        <artifactId>knotra-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>knotra-integration-tests</artifactId>
    <name>Knotra Integration Tests</name>
    <description>Test-only cross-module verification assembly; never published.</description>

    <properties>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.knotra</groupId>
            <artifactId>knotra-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.knotra</groupId>
            <artifactId>knotra-events</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.knotra</groupId>
            <artifactId>knotra-pf4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.knotra</groupId>
            <artifactId>knotra-loader</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-shared-test-contract</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/contract</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/test-classes</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-integration-plugin</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/test/plugin</compileSourceRoot>
                                <compileSourceRoot>${project.basedir}/src/test/contract</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${project.build.directory}/plugin-classes</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-integration-plugin-extension-index</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/plugin-classes</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/test/plugin</directory>
                                    <includes>
                                        <include>META-INF/extensions.idx</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <skipIfEmpty>true</skipIfEmpty>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-plugin-jar</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/plugin-classes</classesDirectory>
                            <outputDirectory>${project.build.directory}/fixtures</outputDirectory>
                            <includes>
                                <include>com/example/integration/plugin/**</include>
                                <include>META-INF/**</include>
                            </includes>
                            <archive>
                                <manifestEntries>
                                    <Plugin-Id>knotra-integration-plugin</Plugin-Id>
                                    <Plugin-Version>1.0.0</Plugin-Version>
                                </manifestEntries>
                            </archive>
                            <classifier>integration-fixture</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
